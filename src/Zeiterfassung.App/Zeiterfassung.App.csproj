<Project Sdk="Microsoft.NET.Sdk">

  <!-- Die Windows-App: Symbol im Infobereich der Taskleiste, Fenster darüber, Einstellungen. WinUI 3 mit dem
       Windows App SDK, verpackt als MSIX. Baut nur unter Windows; die Abläufe stecken in Zeiterfassung.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Zeiterfassung.App</RootNamespace>
    <AssemblyName>Zeiterfassung</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <DefaultLanguage>de-DE</DefaultLanguage>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
  </PropertyGroup>

  <!-- Unverpackte Fassung: dieselbe App ohne MSIX und ohne Signatur, zum Entpacken aus einem ZIP. Der Bau setzt
       WindowsPackageType=None, dann startet das Windows App SDK ohne Paketidentität (RegFree WinRT). Weil die App
       schon self-contained ist, braucht sie dafür nichts zusätzlich installiert.

       Die Ressourcen sind der Knackpunkt: WinUI holt die Vorlagen seiner Bedienelemente über ms-resource: aus einer
       PRI-Datei. Beim Bau heißt sie <AssemblyName>.pri, und erst das MSIX-Packen legt sie als resources.pri ins
       Paket. Ohne Paket lädt die Laufzeit aber genau die Datei resources.pri neben der Programmdatei; fehlt sie,
       bricht die App beim ersten Bedienelement in Microsoft.UI.Xaml.dll ab (Ausnahmecode 0xc000027b). Der Inhalt
       stimmt schon, auch die Ressourcen von WinUI selbst sind darin — es ist allein der Name. -->
  <PropertyGroup Condition="'$(WindowsPackageType)' == 'None'">
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Nur WinUI und seine Grundlagen. Das Sammelpaket Microsoft.WindowsAppSDK brächte KI-, ML-, Such- und
         Widget-Bausteine mit, die das Paket um Dutzende MB vergrößern. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zeiterfassung.Core\Zeiterfassung.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectCapability Include="Msix" />
  </ItemGroup>

</Project>
