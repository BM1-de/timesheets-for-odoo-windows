     Inhalt des Fensters über dem Symbol im Infobereich: Tag, laufende Projektzeit, Anwesenheit, Einträge und das
     Formular für einen neuen Eintrag. Ein Klick auf einen Eintrag öffnet ihn dort zum Bearbeiten. -->
<UserControl
    x:Class="Zeiterfassung.App.Views.PanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:z="using:Zeiterfassung.App"
    xmlns:views="using:Zeiterfassung.App.Views"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <UserControl.Resources>
        <!-- Einträge: Zwischenüberschrift einer Firma oder ein Eintrag -->
        <DataTemplate x:Key="EntryHeaderTemplate" x:DataType="views:EntryRowItem">
            <Grid Padding="12,6,38,4" Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                  ColumnSpacing="10" AutomationProperties.Name="{x:Bind AccessibilityText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Title}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{x:Bind Duration}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Typography.NumeralAlignment="Tabular" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EntryTemplate" x:DataType="views:EntryRowItem">
            <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                  Background="{x:Bind SelectionBrush}" PointerEntered="EntryRow_PointerEntered" PointerExited="EntryRow_PointerExited">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource RowButtonStyle}" Padding="12,8,4,8" Click="EntryRow_Click"
                        AutomationProperties.Name="{x:Bind AccessibilityText}" ToolTipService.ToolTip="{x:Bind ToolTipText}">
                    <Button.ContextFlyout>
                        <MenuFlyout Opening="EntryMenu_Opening" />
                    </Button.ContextFlyout>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="-8,0,0,0" HorizontalAlignment="Left"
                                   Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind z:Show.If(IsSelected)}" />
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"
                                       Foreground="{x:Bind TitleBrush}" />
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource SecondaryCaptionStyle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <FontIcon Grid.Column="1" Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Visibility="{x:Bind z:Show.If(IsLocked)}" ToolTipService.ToolTip="{x:Bind LockLabel}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Duration}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                    </Grid>
                </Button>
                <Button x:Name="ResumeButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                        CornerRadius="13" Margin="0,0,8,0" Opacity="0" Click="ResumeEntry_Click" IsTabStop="False"
                        Visibility="{x:Bind z:Show.If(CanStart)}" ToolTipService.ToolTip="{z:Str Key='Erneut starten'}"
                        AutomationProperties.AccessibilityView="Raw">
                    <FontIcon Glyph="&#xE768;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Button>
            </Grid>
        </DataTemplate>

        <views:EntryTemplateSelector x:Key="EntryTemplates"
                                     Header="{StaticResource EntryHeaderTemplate}"
                                     Entry="{StaticResource EntryTemplate}" />

        <!-- Zeiten des Tages: Anwesenheit, Pause, eingefügte Pause, Felder zum Korrigieren -->
        <DataTemplate x:Key="PeriodTemplate" x:DataType="views:AttendanceRowItem">
            <Button Style="{StaticResource RowButtonStyle}" Padding="30,7,12,7" Click="AttendanceRow_Click" IsEnabled="{x:Bind CanEdit}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                    PointerEntered="AttendanceRow_PointerEntered" PointerExited="AttendanceRow_PointerExited"
                    AutomationProperties.Name="{x:Bind AccessibilityText}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind Range}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{x:Bind RangeBrush}"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{x:Bind Remark}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind z:Show.IfText(Remark)}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{x:Bind Duration}" Style="{StaticResource SecondaryCaptionStyle}"
                               VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                    <FontIcon x:Name="Pen" Grid.Column="2" Glyph="&#xE70F;" FontSize="12" Opacity="0"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind z:Show.If(CanEdit)}" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="InsertedBreakTemplate" x:DataType="views:AttendanceRowItem">
            <Grid Padding="30,6,12,6" ColumnSpacing="8" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                  AutomationProperties.Name="{x:Bind AccessibilityText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Range}" Style="{StaticResource CaptionTextBlockStyle}" Typography.NumeralAlignment="Tabular" />
                    <TextBlock Text="{z:Str Key='Von Odoo eingefügt'}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind Duration}" Style="{StaticResource SecondaryCaptionStyle}"
                           VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                <Button Grid.Column="2" Content="{z:Str Key='Verschieben'}" FontSize="12" Padding="9,2,9,3"
                        Visibility="{x:Bind z:Show.If(CanEdit)}" Click="AttendanceRow_Click" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EditorTemplate" x:DataType="views:AttendanceRowItem">
            <StackPanel Spacing="8" Padding="30,9,12,10" Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="{x:Bind Editor.Heading, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                           Visibility="{x:Bind z:Show.IfText(Editor.Heading), Mode=OneWay}" />
                <TextBlock Text="{x:Bind Editor.Warning, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           Visibility="{x:Bind z:Show.IfText(Editor.Warning), Mode=OneWay}" />
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{z:Str Key='von'}" Style="{StaticResource SecondaryCaptionStyle}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Width="62" MinWidth="62" FontSize="12" TextAlignment="Center" InputScope="Number"
                             Text="{x:Bind Editor.From, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="8:00"
                             AutomationProperties.Name="{z:Str Key='Beginn'}" Loaded="EditorFrom_Loaded" KeyDown="EditorField_KeyDown" />
                    <TextBlock Grid.Column="2" Text="{z:Str Key='bis'}" Style="{StaticResource SecondaryCaptionStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{z:Str Key='jetzt'}" Style="{StaticResource SecondaryCaptionStyle}" VerticalAlignment="Center"
                               Visibility="{x:Bind z:Show.If(Editor.IsOpenEnd), Mode=OneWay}" />
                    <TextBox Grid.Column="3" Width="62" MinWidth="62" FontSize="12" TextAlignment="Center" InputScope="Number"
                             Text="{x:Bind Editor.To, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="12:00"
                             Visibility="{x:Bind z:Show.Unless(Editor.IsOpenEnd), Mode=OneWay}"
                             AutomationProperties.Name="{z:Str Key='Ende'}" Loaded="EditorTo_Loaded" KeyDown="EditorField_KeyDown" />
                    <TextBlock Grid.Column="4" Text="{x:Bind Editor.Duration, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                </Grid>
                <TextBlock Text="{x:Bind Editor.Hint, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{x:Bind Editor.HintBrush, Mode=OneWay}" Visibility="{x:Bind z:Show.IfText(Editor.Hint), Mode=OneWay}" />
                <TextBlock Text="{x:Bind Editor.Error, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind z:Show.IfText(Editor.Error), Mode=OneWay}" />
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButtonStyle}" Width="26" Click="DeletePeriod_Click"
                            Visibility="{x:Bind z:Show.If(Editor.CanDelete), Mode=OneWay}"
                            AutomationProperties.Name="{z:Str Key='Zeitraum löschen'}" ToolTipService.ToolTip="{z:Str Key='Zeitraum löschen'}">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </Button>
                    <controls:ProgressRing Grid.Column="2" Width="16" Height="16" IsActive="{x:Bind Editor.IsSaving, Mode=OneWay}"
                                           Visibility="{x:Bind z:Show.If(Editor.IsSaving), Mode=OneWay}" />
                    <Button Grid.Column="3" Style="{StaticResource AccentButtonStyle}" FontSize="12" Padding="13,4,13,5"
                            Content="{x:Bind Editor.SaveTitle, Mode=OneWay}" IsEnabled="{x:Bind z:Show.Not(Editor.IsSaving), Mode=OneWay}"
                            Click="SaveAttendance_Click" />
                    <Button Grid.Column="4" FontSize="12" Padding="11,4,11,5" Content="{z:Str Key='Abbrechen'}" Click="CancelAttendance_Click" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <views:AttendanceTemplateSelector x:Key="AttendanceTemplates"
                                          Period="{StaticResource PeriodTemplate}"
                                          InsertedBreak="{StaticResource InsertedBreakTemplate}"
                                          Editor="{StaticResource EditorTemplate}" />

        <!-- Projektauswahl -->
        <DataTemplate x:Key="PickerHeaderTemplate" x:DataType="views:PickerItem">
            <TextBlock Text="{x:Bind Title}" Margin="8,4,8,3" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <DataTemplate x:Key="PickerSeparatorTemplate" x:DataType="views:PickerItem">
            <Rectangle Style="{StaticResource SeparatorStyle}" Margin="8,5,8,5" />
        </DataTemplate>

        <DataTemplate x:Key="PickerOptionTemplate" x:DataType="views:PickerItem">
            <Button Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Padding="4,0,8,0" Height="30" Background="{x:Bind HighlightBrush}" Click="PickProject_Click"
                    AutomationProperties.Name="{x:Bind AccessibilityText}">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MaxWidth="150" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE73E;" FontSize="12" Visibility="{x:Bind z:Show.If(IsSelected)}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Company}" Style="{StaticResource SecondaryCaptionStyle}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Visibility="{x:Bind z:Show.IfText(Company)}" />
                </Grid>
            </Button>
        </DataTemplate>

        <views:PickerTemplateSelector x:Key="PickerTemplates"
                                      Header="{StaticResource PickerHeaderTemplate}"
                                      Separator="{StaticResource PickerSeparatorTemplate}"
                                      Option="{StaticResource PickerOptionTemplate}" />
    </UserControl.Resources>

    <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="Refresh_Invoked" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="PreviousDay_Invoked" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="NextDay_Invoked" />
            <KeyboardAccelerator Key="Home" Modifiers="Menu" Invoked="Today_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- Start: Die Verbindung wird geladen -->
        <controls:ProgressRing Width="24" Height="24" Margin="0,40" IsActive="{x:Bind IsStarting, Mode=OneWay}"
                               Visibility="{x:Bind z:Show.If(IsStarting), Mode=OneWay}" />

        <!-- Anmeldung -->
        <views:LoginView x:Name="Login" VerticalAlignment="Top" SizeChanged="Part_SizeChanged"
                         Visibility="{x:Bind z:Show.If(IsLogin), Mode=OneWay}" />

        <!-- Tag -->
        <Grid x:Name="DayPanel" Visibility="{x:Bind z:Show.If(IsMain), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Kopf: Tag und Blättern -->
            <Grid x:Name="Header" Padding="16,12,10,10" ColumnSpacing="8" SizeChanged="Part_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="1">
                    <TextBlock Text="{x:Bind Model.DayTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind Model.DayLongDate, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" />
                </StackPanel>
                <controls:ProgressRing Grid.Column="1" Width="16" Height="16" IsActive="{x:Bind Model.IsLoading, Mode=OneWay}"
                                       Visibility="{x:Bind z:Show.If(Model.IsLoading), Mode=OneWay}"
                                       AutomationProperties.Name="{z:Str Key='Wird geladen'}" />
                <Button Grid.Column="2" Content="{z:Str Key='Heute'}" FontSize="12" Padding="10,3,10,4" VerticalAlignment="Center"
                        Visibility="{x:Bind z:Show.Unless(Model.IsShowingToday), Mode=OneWay}" Click="Today_Click"
                        ToolTipService.ToolTip="{x:Bind TodayHelp}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButtonStyle}" Height="32" Click="PreviousDay_Click"
                            AutomationProperties.Name="{z:Str Key='Vorheriger Tag'}" ToolTipService.ToolTip="{x:Bind PreviousDayHelp}">
                        <FontIcon Glyph="&#xE76B;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Height="32" Click="NextDay_Click"
                            AutomationProperties.Name="{z:Str Key='Nächster Tag'}" ToolTipService.ToolTip="{x:Bind NextDayHelp}">
                        <FontIcon Glyph="&#xE76C;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Hinweise: Verbindung, Update -->
            <StackPanel x:Name="Banners" Grid.Row="1" Spacing="10" Margin="12,0,12,0" SizeChanged="Part_SizeChanged">
                <controls:InfoBar IsOpen="{x:Bind HasNotice, Mode=OneWay}" IsClosable="False" Severity="{x:Bind NoticeSeverity, Mode=OneWay}"
                                  Message="{x:Bind NoticeMessage, Mode=OneWay}" Margin="0,0,0,10"
                                  Visibility="{x:Bind z:Show.If(HasNotice), Mode=OneWay}">
                    <controls:InfoBar.ActionButton>
                        <Button Content="{x:Bind NoticeAction, Mode=OneWay}" Click="NoticeAction_Click" />
                    </controls:InfoBar.ActionButton>
                </controls:InfoBar>
                <controls:InfoBar IsOpen="{x:Bind ShowsUpdate, Mode=OneWay}" Severity="{x:Bind UpdateSeverity, Mode=OneWay}"
                                  Message="{x:Bind UpdateText, Mode=OneWay}" IsClosable="{x:Bind UpdateClosable, Mode=OneWay}"
                                  Closed="Update_Closed" Margin="0,0,0,10" Visibility="{x:Bind z:Show.If(ShowsUpdate), Mode=OneWay}">
                    <controls:InfoBar.ActionButton>
                        <Button Content="{z:Str Key='Installieren …'}" Visibility="{x:Bind z:Show.If(UpdateCanInstall), Mode=OneWay}"
                                Click="InstallUpdate_Click" />
                    </controls:InfoBar.ActionButton>
                </controls:InfoBar>
            </StackPanel>

            <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <StackPanel x:Name="ContentStack" Spacing="14" Padding="12,2,12,14" SizeChanged="Part_SizeChanged">

                    <!-- Keine Funktion eingeschaltet -->
                    <Border Style="{StaticResource GroupStyle}" Padding="16,22,16,22" Visibility="{x:Bind z:Show.If(Model.NoFeatureActive), Mode=OneWay}">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="{z:Str Key='Keine Funktion eingeschaltet'}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{z:Str Key='Zeiterfassung und Anwesenheit sind ausgeschaltet oder in dieser Odoo-Datenbank nicht verfügbar.'}"
                                       Style="{StaticResource SecondaryCaptionStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                            <HyperlinkButton Content="{z:Str Key='Einstellungen öffnen …'}" FontSize="12" HorizontalAlignment="Center"
                                             Margin="0,6,0,0" Click="OpenSettings_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Laufende Projektzeit -->
                    <StackPanel Spacing="8" Visibility="{x:Bind z:Show.If(ShowsTimerSection), Mode=OneWay}">
                        <Border Style="{StaticResource GroupStyle}" Padding="12,10,8,10" Visibility="{x:Bind z:Show.If(HasTimer), Mode=OneWay}"
                                AutomationProperties.Name="{z:Str Key='Laufende Projektzeit'}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="TimerDot" Width="8" Height="8" Fill="{x:Bind TimerDotBrush, Mode=OneWay}" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBox x:Name="TimerDescriptionBox" Text="{x:Bind TimerDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{z:Str Key='Was machst du gerade?'}" FontWeight="SemiBold" Margin="-6,0,0,0"
                                             Padding="6,3,6,3" MinHeight="26" BorderThickness="0" Background="Transparent"
                                             IsEnabled="{x:Bind TimerDescriptionEditable, Mode=OneWay}"
                                             AutomationProperties.Name="{z:Str Key='Beschreibung der laufenden Zeit'}" />
                                    <HyperlinkButton Padding="0" FontSize="12" Click="TimerPath_Click" IsEnabled="{x:Bind TimerPathEditable, Mode=OneWay}"
                                                     ToolTipService.ToolTip="{z:Str Key='Projekt, Aufgabe und Beschreibung ändern'}"
                                                     Foreground="{x:Bind TimerPathBrush, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind Model.TimerPathText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    </HyperlinkButton>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind TimerSpoken, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind TimerElapsed, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"
                                               Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Text="{x:Bind Model.TimerStartText, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}"
                                               HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Click="DiscardTimer_Click"
                                        IsEnabled="{x:Bind z:Show.Not(Model.IsStoppingTimer), Mode=OneWay}"
                                        AutomationProperties.Name="{z:Str Key='Verwerfen …'}" ToolTipService.ToolTip="{z:Str Key='Verwerfen …'}">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Button>
                                <Grid Grid.Column="4" Width="32" Height="32">
                                    <controls:ProgressRing Width="18" Height="18" IsActive="{x:Bind Model.IsStoppingTimer, Mode=OneWay}"
                                                           Visibility="{x:Bind z:Show.If(Model.IsStoppingTimer), Mode=OneWay}" />
                                    <Button Width="32" Height="32" Padding="0" CornerRadius="16" Click="StopTimer_Click"
                                            Background="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="0"
                                            Visibility="{x:Bind z:Show.If(ShowsStopButton), Mode=OneWay}"
                                            AutomationProperties.Name="{z:Str Key='Stoppen und buchen'}" ToolTipService.ToolTip="{z:Str Key='Stoppen und buchen'}">
                                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="White" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Gestoppt, aber noch nicht gebucht -->
                        <controls:InfoBar IsOpen="{x:Bind ShowsStoppedNote, Mode=OneWay}" IsClosable="False" Severity="Warning"
                                          Message="{x:Bind StoppedNoteText, Mode=OneWay}" Visibility="{x:Bind z:Show.If(ShowsStoppedNote), Mode=OneWay}">
                            <controls:InfoBar.ActionButton>
                                <Button Content="{x:Bind StoppedNoteButton, Mode=OneWay}" Click="BookTimer_Click" />
                            </controls:InfoBar.ActionButton>
                        </controls:InfoBar>
                        <controls:InfoBar IsOpen="{x:Bind ShowsTimerError, Mode=OneWay}" IsClosable="False" Severity="Error"
                                          Title="{z:Str Key='Projektzeit konnte nicht gebucht werden'}" Message="{x:Bind TimerErrorText, Mode=OneWay}"
                                          Visibility="{x:Bind z:Show.If(ShowsTimerError), Mode=OneWay}">
                            <controls:InfoBar.ActionButton>
                                <Button Content="{z:Str Key='Erneut versuchen'}" Click="StopTimer_Click"
                                        IsEnabled="{x:Bind z:Show.Not(Model.IsStoppingTimer), Mode=OneWay}" />
                            </controls:InfoBar.ActionButton>
                        </controls:InfoBar>
                        <controls:InfoBar IsOpen="{x:Bind HasTimerNotice, Mode=OneWay}" Severity="{x:Bind TimerNoticeSeverity, Mode=OneWay}"
                                          Message="{x:Bind TimerNoticeText, Mode=OneWay}" Closed="TimerNotice_Closed"
                                          Visibility="{x:Bind z:Show.If(HasTimerNotice), Mode=OneWay}" />
                    </StackPanel>

                    <!-- Anwesenheit -->
                    <StackPanel Spacing="6" Visibility="{x:Bind z:Show.If(Model.AttendanceActive), Mode=OneWay}">
                        <TextBlock Text="{z:Str Key='Anwesenheit'}" Style="{StaticResource SectionTitleStyle}"
                                   Visibility="{x:Bind z:Show.Unless(Model.TimesheetsActive), Mode=OneWay}" />
                        <Border Style="{StaticResource GroupStyle}" AutomationProperties.Name="{z:Str Key='Anwesenheit'}">
                            <StackPanel>
                                <Grid Padding="12,10,10,10" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="14" Height="14" VerticalAlignment="Center">
                                        <Ellipse Width="14" Height="14" Fill="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                 Visibility="{x:Bind z:Show.If(Summary.IsRunning), Mode=OneWay}" />
                                        <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                 Visibility="{x:Bind z:Show.If(Summary.IsRunning), Mode=OneWay}" />
                                        <Ellipse Width="7" Height="7" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5"
                                                 Visibility="{x:Bind z:Show.Unless(Summary.IsRunning), Mode=OneWay}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Summary.Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Summary.Subtitle, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}"
                                                   TextWrapping="Wrap" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                    <controls:ProgressRing Grid.Column="2" Width="16" Height="16" IsActive="{x:Bind Model.IsStamping, Mode=OneWay}"
                                                           Visibility="{x:Bind z:Show.If(Model.IsStamping), Mode=OneWay}" />
                                    <Button Grid.Column="3" Content="{x:Bind Summary.ButtonTitle, Mode=OneWay}" FontSize="12" Padding="12,4,12,5"
                                            Visibility="{x:Bind z:Show.If(HasSummaryButton), Mode=OneWay}"
                                            IsEnabled="{x:Bind z:Show.Not(Model.IsStamping), Mode=OneWay}" Click="Stamp_Click" />
                                    <Button Grid.Column="3" Content="{z:Str Key='Nachtragen …'}" FontSize="12" Padding="12,4,12,5"
                                            Visibility="{x:Bind z:Show.If(OffersAddingInHeader), Mode=OneWay}" Click="AddPeriod_Click" />
                                </Grid>

                                <!-- „Zeiten des Tages“ zum Auf- und Zuklappen -->
                                <Button Style="{StaticResource RowButtonStyle}" Padding="30,0,12,0" MinHeight="36" Click="ToggleAttendanceList_Click"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                                        Visibility="{x:Bind z:Show.If(ShowsAttendanceToggle), Mode=OneWay}"
                                        AutomationProperties.Name="{z:Str Key='Zeiten des Tages'}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{z:Str Key='Zeiten des Tages'}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                                                    Visibility="{x:Bind z:Show.If(HasAttention), Mode=OneWay}">
                                            <Ellipse Width="6" Height="6" Fill="{ThemeResource SystemFillColorCautionBrush}" />
                                            <TextBlock Text="{x:Bind Summary.Attention, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind PeriodsLabel, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}"
                                                   VerticalAlignment="Center" Visibility="{x:Bind z:Show.Unless(HasAttention), Mode=OneWay}" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  RenderTransformOrigin="0.5,0.5">
                                            <FontIcon.RenderTransform>
                                                <RotateTransform Angle="{x:Bind ChevronAngle, Mode=OneWay}" />
                                            </FontIcon.RenderTransform>
                                        </FontIcon>
                                    </Grid>
                                </Button>

                                <ItemsRepeater ItemsSource="{x:Bind AttendanceItems, Mode=OneWay}" ItemTemplate="{StaticResource AttendanceTemplates}"
                                               Visibility="{x:Bind z:Show.If(ShowsAttendanceList), Mode=OneWay}" />

                                <Button Style="{StaticResource RowButtonStyle}" Padding="30,0,12,0" MinHeight="36" Click="AddPeriod_Click"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Visibility="{x:Bind z:Show.If(ShowsAddRow), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE710;" FontSize="11" />
                                        <TextBlock Text="{z:Str Key='Zeitraum nachtragen'}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Button>

                                <!-- Ergebnis nach dem Sichern -->
                                <controls:InfoBar IsOpen="{x:Bind HasAttendanceNotice, Mode=OneWay}" Severity="{x:Bind AttendanceNoticeSeverity, Mode=OneWay}"
                                                  Message="{x:Bind AttendanceNoticeText, Mode=OneWay}" Closed="AttendanceNotice_Closed" CornerRadius="0"
                                                  BorderThickness="0,1,0,0" Visibility="{x:Bind z:Show.If(HasAttendanceNotice), Mode=OneWay}" />

                                <Grid Padding="12,7,12,7" Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                                      Visibility="{x:Bind z:Show.If(HasUnbooked), Mode=OneWay}">
                                    <TextBlock Text="{z:Str Key='Noch nicht auf Projekte gebucht'}" Style="{StaticResource SecondaryCaptionStyle}" />
                                    <TextBlock Text="{x:Bind Summary.UnbookedText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                                </Grid>

                                <Grid Padding="12,8,12,9" ColumnSpacing="7" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                                      Visibility="{x:Bind z:Show.If(HasSummaryNote), Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE72E;" FontSize="12" VerticalAlignment="Top" Margin="0,1,0,0"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Summary.Note, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}"
                                               TextWrapping="Wrap" />
                                </Grid>

                                <TextBlock Padding="12,7,12,7" Text="{x:Bind Model.StampError, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           Visibility="{x:Bind z:Show.If(HasStampError), Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Einträge -->
                    <StackPanel Spacing="6" Visibility="{x:Bind z:Show.If(Model.TimesheetsActive), Mode=OneWay}">
                        <Grid Margin="6,0,6,0">
                            <TextBlock Text="{z:Str Key='Einträge'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Model.EntryCountText, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Visibility="{x:Bind z:Show.If(HasEntries), Mode=OneWay}" />
                        </Grid>
                        <Border Style="{StaticResource GroupStyle}" AutomationProperties.Name="{z:Str Key='Einträge'}">
                            <StackPanel>
                                <ScrollViewer MaxHeight="{x:Bind EntriesMaxHeight, Mode=OneWay}" VerticalScrollBarVisibility="Auto">
                                    <ItemsRepeater ItemsSource="{x:Bind EntryItems, Mode=OneWay}" ItemTemplate="{StaticResource EntryTemplates}" />
                                </ScrollViewer>
                                <StackPanel Spacing="4" Padding="16,20,16,18" HorizontalAlignment="Stretch"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                                            Visibility="{x:Bind z:Show.Unless(HasEntries), Mode=OneWay}">
                                    <FontIcon Glyph="&#xE787;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Visibility="{x:Bind z:Show.If(Model.IsDayLoaded), Mode=OneWay}" />
                                    <controls:ProgressRing Width="16" Height="16" IsActive="{x:Bind z:Show.Not(Model.IsDayLoaded), Mode=OneWay}"
                                                           Visibility="{x:Bind z:Show.Unless(Model.IsDayLoaded), Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind EmptyTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center"
                                               Margin="0,4,0,0" Visibility="{x:Bind z:Show.IfText(EmptyTitle), Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind EmptyText, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" HorizontalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid Padding="12,8,12,8" Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                      AutomationProperties.Name="{x:Bind SumSpoken, Mode=OneWay}">
                                    <TextBlock Text="{z:Str Key='Summe'}" Style="{StaticResource SecondaryCaptionStyle}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind SumText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right"
                                               Typography.NumeralAlignment="Tabular" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Formular -->
                    <StackPanel x:Name="Form" Spacing="6" Visibility="{x:Bind z:Show.If(Model.TimesheetsActive), Mode=OneWay}">
                        <TextBlock Text="{x:Bind FormTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="4,0,4,0" />
                        <Border Style="{StaticResource GroupStyle}">
                            <StackPanel>
                                <!-- Projekt -->
                                <Grid Padding="12,0,8,0" MinHeight="44" ColumnSpacing="10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button x:Name="ProjectButton" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Margin="-6,4,0,4" Padding="6,2,6,2" MinHeight="32"
                                            IsEnabled="{x:Bind z:Show.Not(FormFixed), Mode=OneWay}" Click="ProjectButton_Click"
                                            AutomationProperties.Name="{z:Str Key='Projekt'}">
                                        <FlyoutBase.AttachedFlyout>
                                            <Flyout x:Name="ProjectFlyout" Placement="Top" Opened="ProjectFlyout_Opened" Closed="ProjectFlyout_Closed">
                                                <Flyout.FlyoutPresenterStyle>
                                                    <Style TargetType="FlyoutPresenter">
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="MinWidth" Value="320" />
                                                        <Setter Property="MaxWidth" Value="440" />
                                                    </Style>
                                                </Flyout.FlyoutPresenterStyle>
                                                <Grid Width="{x:Bind PickerWidth, Mode=OneWay}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="40" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Padding="10,0,10,0" ColumnSpacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                          BorderThickness="0,0,0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBox x:Name="ProjectSearch" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                                                 PlaceholderText="{z:Str Key='Projekt oder Kunde suchen'}"
                                                                 Text="{x:Bind PickerQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 KeyDown="ProjectSearch_KeyDown" AutomationProperties.Name="{z:Str Key='Projekt suchen'}" />
                                                    </Grid>
                                                    <ScrollViewer x:Name="PickerScroller" Grid.Row="1" Height="{x:Bind PickerHeight, Mode=OneWay}"
                                                                  VerticalScrollBarVisibility="Auto">
                                                        <StackPanel Padding="5">
                                                            <ItemsRepeater x:Name="PickerList" ItemsSource="{x:Bind PickerItems, Mode=OneWay}"
                                                                           ItemTemplate="{StaticResource PickerTemplates}" />
                                                            <TextBlock Text="{x:Bind PickerEmptyText, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}"
                                                                       HorizontalAlignment="Center" Margin="8,14,8,14"
                                                                       Visibility="{x:Bind z:Show.IfText(PickerEmptyText), Mode=OneWay}" />
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                    <TextBlock Grid.Row="2" Padding="12,6,12,6" Text="{z:Str Key='Eingabe übernehmen · Esc schließen'}"
                                                               Style="{StaticResource SecondaryCaptionStyle}" />
                                                </Grid>
                                            </Flyout>
                                        </FlyoutBase.AttachedFlyout>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind ProjectLabel, Mode=OneWay}" Foreground="{x:Bind ProjectLabelBrush, Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Model.SelectedProjectCompanyText, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}"
                                                           TextTrimming="CharacterEllipsis" Visibility="{x:Bind z:Show.If(HasProjectCompany), Mode=OneWay}" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                </Grid>

                                <!-- Aufgabe -->
                                <Grid Padding="12,0,8,0" MinHeight="44" ColumnSpacing="10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8FD;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button x:Name="TaskButton" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Margin="-6,0,0,0" Padding="6,0,6,0" Height="32"
                                            IsEnabled="{x:Bind TaskChooserEnabled, Mode=OneWay}" Click="TaskButton_Click"
                                            AutomationProperties.Name="{z:Str Key='Aufgabe'}">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind TaskLabel, Mode=OneWay}" Foreground="{x:Bind TaskLabelBrush, Mode=OneWay}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      Visibility="{x:Bind z:Show.If(TaskChooserEnabled), Mode=OneWay}" />
                                        </Grid>
                                    </Button>
                                    <controls:ProgressRing Grid.Column="2" Width="16" Height="16" IsActive="{x:Bind TasksLoading, Mode=OneWay}"
                                                           Visibility="{x:Bind z:Show.If(TasksLoading), Mode=OneWay}" />
                                    <Button Grid.Column="2" Content="{z:Str Key='Erneut laden'}" FontSize="12" Padding="9,2,9,3"
                                            Visibility="{x:Bind z:Show.If(TasksFailed), Mode=OneWay}" Click="RetryTasks_Click" />
                                </Grid>

                                <!-- Beschreibung -->
                                <Grid Padding="12,0,8,0" MinHeight="44" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8E4;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox x:Name="DescriptionBox" Grid.Column="1" Margin="-6,0,0,0" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                             Text="{x:Bind DraftDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{x:Bind DescriptionPlaceholder, Mode=OneWay}"
                                             IsEnabled="{x:Bind z:Show.Not(Model.EditingIsLocked), Mode=OneWay}" KeyDown="FormField_KeyDown"
                                             AutomationProperties.Name="{z:Str Key='Beschreibung'}" />
                                </Grid>

                                <!-- Dauer -->
                                <Grid Padding="12,0,8,0" MinHeight="48" ColumnSpacing="10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,1,0,0" Visibility="{x:Bind z:Show.If(ShowsDuration), Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE916;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox x:Name="DurationBox" Grid.Column="1" Width="64" MinWidth="64" TextAlignment="Right" InputScope="Number" VerticalAlignment="Center"
                                             PlaceholderText="0:00" Text="{x:Bind DraftDuration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{x:Bind z:Show.Not(FormFixed), Mode=OneWay}" LostFocus="DurationBox_LostFocus" KeyDown="FormField_KeyDown"
                                             AutomationProperties.Name="{z:Str Key='Dauer in Stunden und Minuten'}" />
                                    <TextBlock Grid.Column="2" Text="{z:Str Key='Std.'}" Style="{StaticResource SecondaryCaptionStyle}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                ToolTipService.ToolTip="{x:Bind StepHelp, Mode=OneWay}">
                                        <Button Style="{StaticResource SubtleButtonStyle}" Width="32" Height="28" Padding="0" CornerRadius="0"
                                                IsEnabled="{x:Bind z:Show.Not(FormFixed), Mode=OneWay}" Click="LessDuration_Click"
                                                AutomationProperties.Name="{x:Bind LessLabel, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE738;" FontSize="11" />
                                        </Button>
                                        <Rectangle Width="1" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                        <Button Style="{StaticResource SubtleButtonStyle}" Width="32" Height="28" Padding="0" CornerRadius="0"
                                                IsEnabled="{x:Bind z:Show.Not(FormFixed), Mode=OneWay}" Click="MoreDuration_Click"
                                                AutomationProperties.Name="{x:Bind MoreLabel, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Datum beim Bearbeiten -->
                                <Grid Padding="12,0,8,0" MinHeight="44" ColumnSpacing="10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,1,0,0" Visibility="{x:Bind z:Show.If(HasEditingEntry), Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE787;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button x:Name="DateButton" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Margin="-6,0,0,0" Padding="6,0,6,0" Height="32"
                                            IsEnabled="{x:Bind z:Show.Not(FormFixed), Mode=OneWay}" Click="DateButton_Click"
                                            AutomationProperties.Name="{z:Str Key='Datum'}">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind EditDayLabel, Mode=OneWay}" VerticalAlignment="Center" />
                                            <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Warum sich ein Eintrag nicht mehr ganz ändern lässt -->
                        <Grid Padding="12,8,12,8" ColumnSpacing="8" CornerRadius="{ThemeResource ControlCornerRadius}"
                              Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                              Visibility="{x:Bind z:Show.IfText(LockNote), Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE72E;" FontSize="13" VerticalAlignment="Top" Margin="0,1,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind LockNote, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock Margin="6,0,6,0" Text="{x:Bind DurationHintText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap" Foreground="{x:Bind DurationHintBrush, Mode=OneWay}"
                                   Visibility="{x:Bind z:Show.IfText(DurationHintText), Mode=OneWay}" />

                        <controls:InfoBar IsOpen="{x:Bind HasSaveError, Mode=OneWay}" IsClosable="False" Severity="Error"
                                          Title="{x:Bind SaveErrorTitle, Mode=OneWay}" Message="{x:Bind Model.SaveError, Mode=OneWay}"
                                          Visibility="{x:Bind z:Show.If(HasSaveError), Mode=OneWay}" />

                        <!-- Knöpfe für einen neuen Eintrag -->
                        <StackPanel Spacing="4" Visibility="{x:Bind z:Show.Unless(IsEditing), Mode=OneWay}">
                            <Grid Padding="6,2,2,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ForDayText, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" VerticalAlignment="Center" />
                                <controls:ProgressRing Grid.Column="1" Width="16" Height="16" IsActive="{x:Bind Model.IsSaving, Mode=OneWay}"
                                                       Visibility="{x:Bind z:Show.If(Model.IsSaving), Mode=OneWay}" />
                                <Button Grid.Column="2" Padding="10,4,12,5" IsEnabled="{x:Bind Model.CanStartTimer, Mode=OneWay}" Click="StartTimer_Click"
                                        Visibility="{x:Bind z:Show.If(Model.OffersTimerStart), Mode=OneWay}"
                                        ToolTipService.ToolTip="{z:Str Key='Ohne Dauer läuft die Zeit ab jetzt, bis du sie stoppst.'}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{z:Str Key='Starten'}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Padding="16,4,16,5" Content="{x:Bind SaveTitle, Mode=OneWay}"
                                        IsEnabled="{x:Bind Model.CanSave, Mode=OneWay}" Click="Save_Click" />
                            </Grid>
                            <TextBlock Margin="6,0,6,0" Text="{x:Bind StartHint, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap"
                                       Visibility="{x:Bind z:Show.IfText(StartHint), Mode=OneWay}" />
                        </StackPanel>

                        <!-- Knöpfe beim Bearbeiten -->
                        <Grid Padding="0,2,2,0" ColumnSpacing="8" Visibility="{x:Bind z:Show.If(IsEditing), Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource SubtleButtonStyle}" Padding="8,4,8,5" Content="{z:Str Key='Löschen …'}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}" Click="DeleteEntry_Click"
                                    Visibility="{x:Bind z:Show.If(CanDeleteEntry), Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Margin="6,0,0,0" Text="{x:Bind TimerForDayText, Mode=OneWay}" Style="{StaticResource SecondaryCaptionStyle}"
                                       VerticalAlignment="Center" Visibility="{x:Bind z:Show.IfText(TimerForDayText), Mode=OneWay}" />
                            <controls:ProgressRing Grid.Column="3" Width="16" Height="16" IsActive="{x:Bind Model.IsSaving, Mode=OneWay}"
                                                   Visibility="{x:Bind z:Show.If(Model.IsSaving), Mode=OneWay}" />
                            <Button Grid.Column="4" Style="{StaticResource AccentButtonStyle}" Padding="16,4,16,5" Content="{x:Bind ConfirmTitle, Mode=OneWay}"
                                    IsEnabled="{x:Bind Model.CanSave, Mode=OneWay}" Click="Save_Click" />
                            <Button Grid.Column="5" Padding="12,4,12,5" Content="{z:Str Key='Abbrechen'}" Click="CancelEditing_Click" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Fuß: In Odoo öffnen, Einstellungen -->
            <Grid x:Name="Footer" Grid.Row="3" Padding="10,6,8,6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                  SizeChanged="Part_SizeChanged">
                <HyperlinkButton Padding="6,4,6,4" FontSize="12" Click="OpenOdoo_Click" Visibility="{x:Bind z:Show.If(HasOdooLink), Mode=OneWay}"
                                 ToolTipService.ToolTip="{x:Bind Model.OdooWebUrl, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{z:Str Key='In Odoo öffnen'}" />
                        <FontIcon Glyph="&#xE8A7;" FontSize="11" />
                    </StackPanel>
                </HyperlinkButton>
                <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right" Height="30" Click="OpenSettings_Click"
                        AutomationProperties.Name="{z:Str Key='Einstellungen'}" ToolTipService.ToolTip="{x:Bind SettingsHelp}">
                    <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
