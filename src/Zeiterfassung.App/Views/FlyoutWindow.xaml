     Fenster über dem Symbol im Infobereich, wie die Flyouts von Windows selbst: ohne Titelleiste, mit Acryl. -->
<Window
    x:Class="Zeiterfassung.App.Views.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Zeiterfassung.App.Views">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" KeyDown="Root_KeyDown">
        <views:PanelView x:Name="Panel" />
    </Grid>
</Window>
