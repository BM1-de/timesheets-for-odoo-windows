          }
        }
      }
    },
    "Vorheriger Tag (Alt+←)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous day (Alt+←)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jour précédent (Alt+←)"
          }
        }
      }
    },
    "Was ist neu in Version %@?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What’s new in version %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quoi de neuf dans la version %@ ?"
          }
        }
      }
    },
    "Zeigst du auf das Symbol im Infobereich, nennt ein Tooltip alle Zeiten von heute.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point at the icon in the notification area to see all of today’s times."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointez sur l’icône dans la zone de notification pour voir tous les temps du jour."
          }
        }
      }
    },
    "Zeit buchen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Book time"
          }
        }
      }
    },
    "Zeiterfassung für Odoo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timesheets for Odoo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Feuilles de temps pour Odoo"
          }
        }
      }
    },
    "Zeiterfassung öffnen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Timesheets"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir les feuilles de temps"
          }
        }
      }
    },
    "Zeitraum löschen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete period"
          }
        }
      }
    },
    "Zu heute (Alt+Pos1)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to today (Alt+Home)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aller à aujourd’hui (Alt+Début)"
          }
        }
      }
    },
    "Zum Anmelden auf das Uhrsymbol im Infobereich der Taskleiste klicken.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To sign in, click the clock icon in the notification area of the taskbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour vous connecter, cliquez sur l’icône d’horloge dans la zone de notification de la barre des tâches."
          }
        }
      }
    },
    "Ändern kannst du das jederzeit in den Einstellungen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change this anytime in settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez modifier cela à tout moment dans les paramètres."
          }
        }
      }
    }
  },
  "version": "1.0"
}
