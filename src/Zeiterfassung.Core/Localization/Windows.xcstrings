    "Updates kommen über den Microsoft Store.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates come through the Microsoft Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour arrivent via le Microsoft Store."
          }
        }
      }
    },
    "Version %@ installieren?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install version %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer la version %@ ?"
          }
        }
      }
    },
    "Version %@ ist installiert.": {
      "localizations": {
