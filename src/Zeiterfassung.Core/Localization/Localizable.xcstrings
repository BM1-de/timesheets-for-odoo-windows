            "value" : "Already invoiced: project, task, duration and date are fixed, and the entry can’t be deleted. You can still change the description."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjà facturée : projet, tâche, durée et date sont figés et la saisie ne peut plus être supprimée. Vous pouvez encore modifier la description."
          }
        }
      }
    },
