    "Rundet die eingetragene Dauer zur nächsten Einheit, bei 15 Minuten zum Beispiel 1:20 auf 1:15 und 0:05 auf 0:15." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rounds the duration you enter to the nearest unit, with 15 minutes for example 1:20 to 1:15 and 0:05 to 0:15."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
