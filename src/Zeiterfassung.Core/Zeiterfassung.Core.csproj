<Project Sdk="Microsoft.NET.Sdk">

  <!-- Alles, was nicht von Windows abhängt: Odoo, Abläufe der App, Demo-Modus, Texte.
       Läuft auch auf macOS und Linux, damit die Tests überall laufen. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Zeiterfassung</RootNamespace>
    <AssemblyName>Zeiterfassung.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\*.xcstrings" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zeiterfassung.Core.Tests" />
  </ItemGroup>

</Project>
